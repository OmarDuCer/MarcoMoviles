<!--
  ============================================================================
   TareasAPI.csproj  —  La "ficha técnica" del proyecto
  ============================================================================

   Este archivo NO tiene lógica de la API: le dice a .NET cómo compilar el
   proyecto y qué librerías externas necesita. Se escribe en XML (etiquetas
   entre < >, parecido a HTML).

   Normalmente no lo editas a mano: lo modifica la herramienta `dotnet` por ti.
  ============================================================================
-->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Versión de .NET sobre la que corre el proyecto. -->
    <TargetFramework>net10.0</TargetFramework>

    <!--
      Activa las advertencias de "posible null". Ayuda muchísimo: el compilador
      te avisa si intentas usar algo que podría no existir.
    -->
    <Nullable>enable</Nullable>

    <!--
      Evita tener que escribir decenas de líneas `using System...` arriba de
      cada archivo: .NET incluye las más comunes automáticamente. Por eso en
      nuestros archivos .cs no verás ningún `using`.
    -->
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Paquetes NuGet = librerías hechas por otros que descargamos e incluimos.

      Microsoft.AspNetCore.OpenApi
          Genera la documentación automática de la API (el JSON de OpenAPI).
          Es oficial de Microsoft.

      Swashbuckle.AspNetCore.SwaggerUi
          Añade la página visual de Swagger en /swagger para probar los
          endpoints con clics. En .NET 9/10 ya no viene incluida por defecto,
          por eso la agregamos aquí.
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUi" Version="10.2.3" />
  </ItemGroup>

</Project>
